# GitHub Project (v2) board used by .claude/scripts/board.sh
# Find the number in the board URL:
#   https://github.com/users/<owner>/projects/<number>   (personal)
#   https://github.com/orgs/<org>/projects/<number>      (organization)

# "@me" for your personal account, or the org login
GH_OWNER="@me"
GH_PROJECT_NUMBER=""

# Name of the single-select field that holds the columns
GH_STATUS_FIELD="Status"
