{
  "name": "@sync-system/server",
  "version": "0.1.0",
  "private": true,
  "description": "Sync server: stores and relays an opaque position for ephemeral groups.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=@sync-system/source src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@redis/client": "6.3.1",
    "@sync-system/protocol": "workspace:*",
    "pino": "^10.4.0",
    "semver": "^7.7.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/semver": "^7.7.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
