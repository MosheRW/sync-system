{
  "name": "@mosherw/sync-system-client",
  "version": "0.1.0",
  "description": "Framework-free sync client: connection, handshake, groups, throttling and reconnect.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MosheRW/sync-system.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/MosheRW/sync-system/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/MosheRW/sync-system/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "@mosherw/sync-system-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit --customConditions @mosherw/sync-system-source",
    "test": "vitest run"
  },
  "dependencies": {
    "@mosherw/sync-system-protocol": "workspace:*"
  },
  "devDependencies": {
    "@mosherw/sync-system-server": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12",
    "ws": "^8.18.0"
  }
}
