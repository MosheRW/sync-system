{
  "name": "@mosherw/sync-system-react",
  "version": "0.1.0",
  "private": true,
  "description": "React and Next.js bindings for @mosherw/sync-system-client: provider, hooks and render-prop helpers, safe during server rendering.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@mosherw/sync-system-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit --customConditions @mosherw/sync-system-source",
    "test": "vitest run"
  },
  "dependencies": {
    "@mosherw/sync-system-client": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3 || ^19"
  },
  "devDependencies": {
    "@mosherw/sync-system-protocol": "workspace:*",
    "@mosherw/sync-system-server": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12",
    "ws": "^8.18.0"
  }
}
